# ---------------------------------------------------------------------------
# bioscope — copy to `.env` and fill in. Every value here is SERVER-SIDE ONLY.
# Never prefix any of these with NEXT_PUBLIC_: they must not reach the browser.
# ---------------------------------------------------------------------------

# Wallet that receives x402 payments. Base Sepolia address.
PAY_TO=0x0000000000000000000000000000000000000000

# x402 facilitator. The public one is EVM testnet only and serves base-sepolia.
FACILITATOR_URL=https://x402.org/facilitator

# CAIP-2 network id. "base-sepolia" is accepted as a shorthand and normalized
# to eip155:84532 by lib/config.ts.
NETWORK=base-sepolia

# USDC on Base Sepolia (6 decimals).
ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# HMAC key for the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every issued session.
SESSION_SECRET=replace-me-with-32-bytes-of-random-hex

# Lifetime of a sign-in session, in seconds (default 86400 = 24h).
SESSION_TTL_SECONDS=86400

# Lifetime of a single SIWX challenge nonce, in seconds (default 300 = 5m).
NONCE_TTL_SECONDS=300

# Origin used in the SIWX challenge message, e.g. http://localhost:3000
SIWX_DOMAIN=http://localhost:3000

# Base for the `resource` field of an x402 payment requirement. Defaults to
# SIWX_DOMAIN. It is server config on purpose: deriving it from the incoming
# request would let a rewritten Host header choose what a payment is bound to.
# APP_ORIGIN=https://bioscope.example

# Where the sqlite file and frame images live. Both are deliberately OUTSIDE
# public/ so Next.js never serves them as static assets.
DATA_DIR=./data

# Optional overrides for the per-reel price map in lib/config.ts.
# Prices are in USDC base units (6 decimals) as a string.
# REEL_PRICES={"reel-1":"10000","reel-2":"25000","reel-3":"5000"}
